/// Curso de capacitacion: varios modulos en orden, cada uno con su video y sus
/// preguntas. Al aprobar todos se emite un certificado con vigencia.
///
/// Se construye sobre los TrainingVideo que ya existian: aquellos son una
/// videoteca suelta, esto es un recorrido con evaluacion y constancia.
model Curso {
  id             String   @id @default(cuid())
  titulo         String
  descripcion    String?
  /// Aseguradora o tema: BMI, Humana, CRM Priority...
  aseguradora    String?
  orden          Int      @default(0)
  /// Mientras no este publicado, solo lo ve quien lo administra.
  publicado      Boolean  @default(false)
  /// Nota minima sobre 100. Con menos de 80 se puede aprobar respondiendo al
  /// azar sin haber visto el video.
  notaMinima     Int      @default(80)
  /// Meses que dura el certificado. Las condiciones de las aseguradoras cambian
  /// cada ano y hay que repasar.
  vigenciaMeses  Int      @default(12)
  /// Minutos de espera tras fallar. Sin espera se puede reintentar al instante
  /// probando opciones hasta acertar, sin haber visto el video.
  esperaMinutos  Int      @default(5)
  /// Tope de intentos por dia y modulo. 0 = sin tope.
  intentosPorDia Int      @default(3)
  organizationId String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User               @relation("CursoCreadoPor", fields: [createdById], references: [id])
  modulos       CursoModulo[]
  certificados  CursoCertificado[]

  @@index([organizationId, orden])
  @@map("cursos")
}

model CursoModulo {
  id          String  @id @default(cuid())
  cursoId     String
  titulo      String
  descripcion String?
  youtubeUrl  String
  duracionMin Int?
  orden       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  curso     Curso           @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  preguntas CursoPregunta[]
  avances   CursoAvance[]

  @@index([cursoId, orden])
  @@map("curso_modulos")
}

model CursoPregunta {
  id          String @id @default(cuid())
  moduloId    String
  enunciado   String
  /// Opciones como JSON: son 2 a 4, se editan siempre juntas y nunca se
  /// consultan por separado. Una tabla propia complicaria el guardado sin
  /// aportar nada.
  opciones    Json
  /// Indice de la opcion correcta dentro de `opciones`.
  correcta    Int
  /// Se muestra despues de responder: es donde de verdad se aprende.
  explicacion String?
  orden       Int    @default(0)

  modulo CursoModulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@index([moduloId, orden])
  @@map("curso_preguntas")
}

/// Avance por modulo. Guarda el MEJOR intento, no el ultimo: si repasa y vuelve
/// a responder peor, no deberia perder lo que ya habia logrado.
model CursoAvance {
  id           String    @id @default(cuid())
  moduloId     String
  userId       String
  aciertos     Int       @default(0)
  total        Int       @default(0)
  aprobado     Boolean   @default(false)
  intentos     Int       @default(0)
  completadoEn DateTime?
  /// Cuando fue el ultimo intento, para exigir la espera.
  ultimoIntentoEn DateTime?
  /// Intentos gastados en `diaDeIntentos`.
  intentosHoy     Int      @default(0)
  /// Dia de esos intentos como YYYY-MM-DD en hora de Ecuador. Se guarda el dia
  /// y no una marca de tiempo para que el corte sea el del calendario local: en
  /// UTC, el dia cambiaria a las 19:00.
  diaDeIntentos   String?

  modulo CursoModulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([moduloId, userId])
  @@index([userId])
  @@map("curso_avances")
}

model CursoCertificado {
  id        String   @id @default(cuid())
  cursoId   String
  userId    String
  nota      Int
  emitidoEn DateTime @default(now())
  /// Fecha calculada al emitir y GUARDADA, no derivada al consultarla: si
  /// manana se cambia la vigencia del curso, los certificados ya entregados
  /// conservan la fecha con la que se emitieron.
  venceEn   DateTime
  /// Codigo corto para verificar el certificado si se presenta impreso.
  codigo    String   @unique

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cursoId, userId])
  @@map("curso_certificados")
}

enum TrainingCategory {
  CRM_USAGE
  QUOTING_TOOLS
  VITALITY
  SALES_TECHNIQUES
  OTHER
}

model TrainingVideoView {
  id       String   @id @default(cuid())
  videoId  String
  userId   String
  viewedAt DateTime @default(now())

  video TrainingVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@map("training_video_views")
}

// ─── WhatsApp Chat ────────────────────────────────────────────────────────────

model WhatsappMessage {
  id                String         @id @default(cuid())
  dealId            String
  direction         WaMsgDirection
  messageType       WaMsgType      @default(TEXT)
  content           String         @default("")
  mediaUrl          String?
  mediaFileName     String?
  sentByUserId      String?
  whatsappMessageId String?
  status            WaMsgStatus    @default(SENT)
  read              Boolean        @default(false)
  createdAt         DateTime       @default(now())

  deal   Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sentBy User? @relation(fields: [sentByUserId], references: [id])

  @@index([dealId, createdAt])
  @@map("whatsapp_messages")
