// Priority CRM - Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ─── Organization ────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  logo      String?
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  registrosAcceso RegistroAcceso[]
  contacts    Contact[]
  deals       Deal[]
  stages      PipelineStage[]
  conversations Conversation[]
  automations Automation[]
  tags        Tag[]
  calendarEvents CalendarEvent[]
  trainingVideos TrainingVideo[]
  clientes    Cliente[]
  polizas     Poliza[]
  reclamos    Reclamo[]
  requerimientos Requerimiento[]
  renovaciones   Renovacion[]
  equipos        Equipo[]
  correosAutomaticos CorreoAutomatico[]
  tareas         Tarea[]
  cursos         Curso[]

  @@map("organizations")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  avatar         String?
  role           UserRole @default(SALES_REP)
  phone          String?
  // Permite emitir cotizaciones a nombre de OTRO asesor. Se usa para los perfiles
  // que cotizan para el equipo comercial. Va apagado por defecto a proposito: si
  // cualquiera pudiera, se podrian emitir cotizaciones a nombre ajeno.
  puedeCotizarPorOtros Boolean @default(false)
  // Permite gestionar negocios propios en "Mi Pipeline" sin ser vendedor de
  // planta. Se usa para los perfiles de Operaciones, que venden de vez en cuando.
  // Es un permiso POR USUARIO, no por rol: asi se le da solo a quien corresponda
  // y una ejecutiva nueva entra sin el hasta que se lo activen a mano.
  // Apagado por defecto, igual que puedeCotizarPorOtros.
  puedeVender          Boolean @default(false)
  /// Cuenta activa. false = no puede entrar, pero su historial se conserva.
  ///
  /// Se desactiva en vez de borrar: borrar pierde quien asigno que, quien
  /// escribio cada nota y sus ventas en el ranking. Y cambiar la contrasena no
  /// sirve, porque no cierra la sesion que ya esta abierta.
  activo               Boolean @default(true)
  desactivadoEn        DateTime?
  desactivadoPor       String?

  /// PIN de 6 digitos para entrar desde el movil, cifrado como una contrasena.
  /// Nunca se guarda en el telefono: se verifica contra el servidor.
  pinHash              String?
  pinCreadoEn          DateTime?
  /// Intentos fallidos seguidos. A los 5 se cierra la sesion.
  pinIntentos          Int     @default(0)
  // Acceso a Priority Help (bot de consulta de coberturas). Cada consulta
  // tiene costo, asi que el acceso se abre asesor por asesor en vez de por
  // rol: Josue decide a quien conviene activarselo.
  // Apagado por defecto: nadie lo gana solo por existir.
  puedePriorityHelp    Boolean @default(false)
  // Equipo comercial al que pertenece. Un usuario esta en UN equipo o en ninguno.
  // Lo asigna el super admin desde la pantalla de Usuarios; los jefes no se
  // auto-asignan gente.
  equipoId       String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Equipo al que pertenece como miembro. SetNull: si se borra el equipo, la
  // persona queda sin equipo, no se borra.
  equipo         Equipo?       @relation("EquipoMiembros", fields: [equipoId], references: [id], onDelete: SetNull)
  // Equipos que lidera. Es una lista por como funciona Prisma, pero en la
  // practica un jefe lidera un solo equipo.
  equiposLiderados Equipo[]    @relation("EquipoJefe")
  tareasAsignadas  Tarea[]    @relation("TareaAsignado")
  tareasSolicitadas Tarea[]   @relation("TareaSolicitante")
  cursosCreados     Curso[]   @relation("CursoCreadoPor")
  cursoAvances      CursoAvance[]
  cursoCertificados CursoCertificado[]
  contacts       Contact[]     @relation("ContactCreatedBy")
  assignedContacts Contact[]   @relation("ContactAssignedTo")
  deals          Deal[]        @relation("DealCreatedBy")
  assignedDeals  Deal[]        @relation("DealAssignedTo")
  activities     Activity[]
  automations    Automation[]
  sentMessages      Message[]
  pushSubscriptions PushSubscription[]
  createdCalendarEvents    CalendarEvent[]            @relation("CalendarEventCreatedBy")
  calendarParticipations   CalendarEventParticipant[]
  createdTrainingVideos   TrainingVideo[]      @relation("TrainingVideoCreatedBy")
  trainingVideoViews      TrainingVideoView[]
  sentWhatsappMessages    WhatsappMessage[]
  clientesAsignados       Cliente[]           @relation("ClienteEjecutivo")
  clientesCreados         Cliente[]           @relation("ClienteCreatedBy")
  notasClientes           NotaCliente[]
  registrosAcceso         RegistroAcceso[]
  notasReclamos           NotaReclamo[]
  requerimientos          Requerimiento[]
  notasRequerimientos     NotaRequerimiento[]
  renovaciones            Renovacion[]        @relation("RenovacionEjecutivo")
  consultasPriorityHelp   PriorityHelpConsulta[]
  notasRenovaciones       NotaRenovacion[]
  reclamosGestionados     Reclamo[]

  @@map("users")
}


// Registro de acceso a datos sensibles. No es para vigilar sino para dejar
// rastro: con datos de salud hay que poder reconstruir quien vio o exporto que.
// El solo hecho de que exista desincentiva el mal uso.
model RegistroAcceso {
  id             String   @id @default(cuid())
  organizationId String

  // Quien lo hizo. Se guarda el nombre aparte por si el usuario se elimina despues.
  usuarioId      String?
  usuarioNombre  String?
  usuarioRol     String?

  // Que hizo: VER_FICHA, EXPORTAR_REPORTE, etc.
  accion         String
  // Sobre que: id del cliente, tipo de reporte, etc. (referencia suelta, no FK,
  // para que el registro sobreviva aunque el objeto se borre).
  objetoTipo     String?
  objetoId       String?
  // Detalle libre legible (ej. "Reporte de reclamos, 1833 filas").
  detalle        String?

  createdAt      DateTime @default(now())

  organizacion   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usuario        User?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, usuarioId, createdAt])
  @@map("registros_acceso")
}


// Bitácora del reclamo. Igual que NotaCliente: una vez escrita no se edita ni se
// borra, solo se agregan nuevas. Guarda el nombre del autor tal cual al momento
// de escribir, para que siga siendo legible aunque esa persona ya no trabaje aquí.
model NotaReclamo {
  id        String   @id @default(cuid())
  contenido String

  reclamoId String
  autorId   String?
  autorNombre String?

  createdAt DateTime @default(now())

  reclamo   Reclamo  @relation(fields: [reclamoId], references: [id], onDelete: Cascade)
  autor     User?    @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([reclamoId, createdAt])
  @@map("notas_reclamo")
}


// Requerimientos: gestiones administrativas del cliente (cambio de forma de pago,
// inclusión de dependientes, cancelaciones...). Es hermano de Reclamo pero NO lo
// mismo: aquí no hay liquidación ni valor, porque no se reclama plata.
model Requerimiento {
  id             String        @id @default(cuid())
  organizationId String

  // Igual que en Reclamo: el vínculo es opcional y el nombre siempre va en texto.
  clienteId      String?
  clienteNombre  String
  pacienteNombre String?

  aseguradora    String?
  // "INDIVIDUAL" o el nombre de la empresa en contratos corporativos.
  contrato       String?

  tipo           TipoRequerimiento @default(OTROS)
  // Solo cuando tipo = OTROS: qué era.
  tipoOtro       String?
  // Detalle de lo que pide el cliente (equivale al diagnóstico del reclamo).
  requerimiento  String?

  fechaRecepcion        DateTime?
  fechaEnvioAseguradora DateTime?
  fechaEnvioCliente     DateTime?

  estado         EstadoRequerimiento @default(EN_TRAMITE)

  observaciones  String?
  /// Poliza a la que corresponde esta bienvenida.
  ///
  /// Un cliente que ya existe y contrata un plan nuevo tambien recibe
  /// bienvenida: es un plan distinto y hay que presentarselo. Ligarlo a la
  /// poliza evita duplicados sin impedir la segunda carta.
  polizaId       String?
  /// Diagnosticos preexistentes que van en la carta. Se escriben a mano: salen
  /// de la poliza emitida por la aseguradora, no de un dato que el CRM tenga.
  preexistencias String?
  /// Cuando se envio el correo de bienvenida. Null = todavia no.
  /// Es fecha y no booleano para saber cuando fue, y ademas evita que se mande
  /// dos veces al mismo cliente.
  correoBienvenidaEnviado DateTime?
  notas          NotaRequerimiento[]

  ejecutivoId    String?
  ejecutivoNombre String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cliente        Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  poliza         Poliza?       @relation(fields: [polizaId], references: [id], onDelete: SetNull)
  ejecutivo      User?         @relation(fields: [ejecutivoId], references: [id], onDelete: SetNull)

  @@index([organizationId, ejecutivoId])
  @@index([organizationId, estado])
  @@index([clienteId])
  @@index([polizaId])
  @@index([organizationId, fechaRecepcion])
  @@map("requerimientos")
}

// Bitácora del requerimiento, igual que la del reclamo: se agrega, no se edita.
model NotaRequerimiento {
  id        String   @id @default(cuid())
  contenido String

  requerimientoId String
  autorId         String?
  autorNombre     String?

  createdAt DateTime @default(now())

  requerimiento Requerimiento @relation(fields: [requerimientoId], references: [id], onDelete: Cascade)
  autor         User?         @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([requerimientoId, createdAt])
  @@map("notas_requerimiento")
}


// Renovaciones. UNA POR PÓLIZA, no por cliente: un mismo cliente puede tener
// varias pólizas que renuevan en meses distintos.
//
// Los datos del cliente y de la póliza NO se copian aquí: se leen de la relación,
// así una corrección en la ficha se refleja sola. Aquí solo viven los datos
// propios de la gestión de renovación, que la ejecutiva llena a mano.
model Renovacion {
  id             String   @id @default(cuid())
  organizationId String

  polizaId       String
  // Fecha en que toca renovar. Se calcula un año después de la vigencia, pero
  // queda editable porque las aseguradoras a veces mueven la fecha.
  fechaRenovacion DateTime

  // Valor que paga hoy. Se precarga de la prima de la póliza y queda editable.
  valorActual     Decimal? @db.Decimal(12, 2)
  // Valor que propone la aseguradora para el año nuevo. Siempre a mano.
  valorRenovacion Decimal? @db.Decimal(12, 2)
  // Alternativa de pago diferido, cuando la aseguradora la ofrece.
  diferidoEspecial Decimal? @db.Decimal(12, 2)
  // El % de incremento NO se guarda: se calcula al mostrar, como en el Excel.

  estado         EstadoRenovacion @default(POR_RENOVAR)
  // Control de envíos, para cuando se automatice el correo.
  envio          EstadoEnvio      @default(NO_ENVIADO)
  fechaPrimerEnvio DateTime?

  /// Texto del correo, ya armado y con los ajustes de la ejecutiva.
  /// Se guarda para que no pierda sus correcciones al cerrar la pantalla.
  correoTexto        String?
  /// Plantilla elegida (clave de PLANTILLAS). Se detecta sola y queda editable.
  correoPlantilla    String?
  /// A quién se le envía. Se precarga del cliente y se puede corregir.
  correoDestinatario String?

  comentarios    String?
  notas          NotaRenovacion[]

  ejecutivoId    String?
  ejecutivoNombre String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poliza         Poliza       @relation(fields: [polizaId], references: [id], onDelete: Cascade)
  ejecutivo      User?        @relation("RenovacionEjecutivo", fields: [ejecutivoId], references: [id], onDelete: SetNull)

  // Una sola renovación por póliza y fecha: evita duplicados al regenerar.
  @@unique([polizaId, fechaRenovacion])
  @@index([organizationId, fechaRenovacion])
  @@index([organizationId, estado])
  @@map("renovaciones")
}

// Bitácora de la renovación: se agrega, no se edita ni se borra.
model NotaRenovacion {
  id           String   @id @default(cuid())
  contenido    String
  renovacionId String
  autorId      String?
  autorNombre  String?
  createdAt    DateTime @default(now())

  renovacion   Renovacion @relation(fields: [renovacionId], references: [id], onDelete: Cascade)
  autor        User?      @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([renovacionId, createdAt])
  @@map("notas_renovacion")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  SALES_REP
  // Jefe de un equipo comercial: ve y reparte los leads de SU equipo, y ademas
  // vende (tiene su propio Mi Pipeline). No ve nada de los otros equipos.
  JEFE_EQUIPO
  // Perfiles del módulo de Operaciones
  OPERACIONES      // ejecutivo de cuenta: ve SOLO sus clientes
  JEFE_OPERACIONES // ve todos los clientes
}

/// Equipo comercial: un jefe y sus vendedores.
///
/// Existe para que cada jefe reparta y supervise UNICAMENTE los leads de su
/// gente. Antes esto se hacia por Excel y mensajes sueltos.
model Equipo {
  id             String   @id @default(cuid())
  nombre         String
  jefeId         String
  organizationId String
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Restrict: no se puede borrar al usuario que es jefe de un equipo sin antes
  // reasignar el equipo. Evita dejar un equipo huerfano con leads dentro.
  jefe           User     @relation("EquipoJefe", fields: [jefeId], references: [id], onDelete: Restrict)
  miembros       User[]   @relation("EquipoMiembros")
  deals          Deal[]   @relation("EquipoDeals")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([jefeId])
  @@map("equipos")
}

/// Registro de correos automaticos enviados a clientes.
///
/// Su razon de ser es la IDEMPOTENCIA: la clave unica (clienteId, tipo, fecha)
/// hace imposible mandarle dos veces el mismo correo al mismo cliente el mismo
/// dia, aunque la tarea se ejecute repetida por un reinicio, un reintento de la
/// cola o dos instancias de la API corriendo a la vez.
///
/// Sin esto, un cliente podria recibir tres "feliz cumpleanos" el mismo dia.
model CorreoAutomatico {
  id             String   @id @default(cuid())
  clienteId      String
  /// CUMPLEANOS | BIENVENIDA | RENOVACION
  tipo           String
  /// Dia al que corresponde el envio, en formato YYYY-MM-DD hora de Ecuador.
  /// Es texto y no DateTime a proposito: asi la clave unica compara dias
  /// calendario y no instantes, sin lios de zona horaria.
  fecha          String
  /// Correo al que se envio, guardado tal como estaba ese dia.
  destinatario   String
  /// true = solo se simulo (modo prueba), no se envio nada de verdad.
  simulado       Boolean  @default(false)
  /// Mensaje de error si el envio fallo. null = salio bien.
  error          String?
  organizationId String
  createdAt      DateTime @default(now())

  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([clienteId, tipo, fecha])
  @@index([organizationId, tipo, fecha])
  @@map("correos_automaticos")
}

/// Tarea del equipo de operaciones.
///
/// Reemplaza la libreta de papel donde las ejecutivas anotan sus pendientes. Va
/// aparte del calendario de la empresa a proposito: mezclar tareas personales
/// con las reuniones haria inutiles a las dos.
model Tarea {
  id             String         @id @default(cuid())
  titulo         String
  detalle        String?
  prioridad      PrioridadTarea @default(MEDIA)
  /// Dia en que hay que hacerla. Sin hora: es una tarea, no una cita.
  fechaLimite    DateTime?      @db.Date
  /// Null = pendiente. Con fecha = hecha, y se sabe cuando.
  completadaEn   DateTime?
  completadaPor  String?

  /// Quien la hace. Es el unico campo que cambia al reasignar.
  asignadoId     String
  /// Quien la pidio. NO cambia al reasignar, para que siga viendo su pedido
  /// aunque lo ejecute otra persona.
  solicitanteId  String
  clienteId      String?
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  subpuntos    TareaSubpunto[]

  asignado     User         @relation("TareaAsignado", fields: [asignadoId], references: [id], onDelete: Restrict)
  solicitante  User         @relation("TareaSolicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)
  cliente      Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([asignadoId, completadaEn])
  @@index([organizationId, fechaLimite])
  @@index([solicitanteId])
  @@index([clienteId])
  @@map("tareas")
}

/// Un paso dentro de una tarea.
///
/// Una tarea como "preparar la renovacion de X" son varios pasos. Sin
/// subpuntos, se ve igual al 20% que al 80%: hecha o no hecha, sin forma de
/// saber si alguien avanzo.
model TareaSubpunto {
  id        String   @id @default(cuid())
  tareaId   String
  texto     String
  hecho     Boolean  @default(false)
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  tarea Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  @@index([tareaId, orden])
  @@map("tarea_subpuntos")
}

enum PrioridadTarea {
  ALTA
  MEDIA
  BAJA
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Contact {
  id             String        @id @default(cuid())
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  company        String?
  position       String?
  avatar         String?
  status         ContactStatus @default(ACTIVE)
  source         String?
  notes          String?
  customFields   Json?
  organizationId String
  createdById    String
  assignedToId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("ContactCreatedBy", fields: [createdById], references: [id])
  assignedTo   User?          @relation("ContactAssignedTo", fields: [assignedToId], references: [id])
  deals        Deal[]
  activities   Activity[]
  conversations Conversation[]
  tags         Tag[]          @relation("ContactTags")
  cliente      Cliente?

  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@map("contacts")
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  LEAD
  CUSTOMER
  CHURNED
}

// ─── Pipeline ────────────────────────────────────────────────────────────────

model PipelineStage {
  id             String   @id @default(cuid())
  name           String
  color          String   @default("#6366f1")
  position       Int
  probability    Int      @default(0)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@index([organizationId, position])
  @@map("pipeline_stages")
}

model Deal {
  id               String     @id @default(cuid())
  title            String
  value            Float?
  currency         String     @default("USD")
  probability      Int?
  expectedCloseDate DateTime?
  closedAt         DateTime?
  status           DealStatus @default(OPEN)
  notes            String?
  customFields     Json?
  position         Int        @default(0)
  stageId          String
  contactId        String?
  organizationId   String
  createdById      String
  assignedToId     String?
  // Equipo dueño del lead, independiente de assignedToId.
  //
  // Son dos cosas distintas: equipoId dice DE QUE JEFE es el lead, y
  // assignedToId dice QUE VENDEDOR lo trabaja. Un lead puede estar sin asignar
  // pero ya pertenecer al equipo de un jefe: asi cada jefe ve su propio lote en
  // la bandeja en vez de una bolsa comun compartida.
  //
  // Null = todavia sin equipo (leads viejos o entrados antes de los equipos).
  // Esos solo los ve gerencia.
  equipoId         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  stage        PipelineStage @relation(fields: [stageId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("DealCreatedBy", fields: [createdById], references: [id])
  assignedTo       User?            @relation("DealAssignedTo", fields: [assignedToId], references: [id])
  // SetNull: si se borra un equipo, el lead NO se borra: vuelve a la bolsa comun
  // para que gerencia lo reparta de nuevo.
  equipo           Equipo?          @relation("EquipoDeals", fields: [equipoId], references: [id], onDelete: SetNull)
  activities       Activity[]
  whatsappMessages WhatsappMessage[]

  @@index([organizationId])
  @@index([stageId, position])
  @@index([equipoId])
  @@map("deals")
}

enum DealStatus {
  OPEN
  WON
  LOST
}

// ─── Communications ───────────────────────────────────────────────────────────

model Conversation {
  id             String              @id @default(cuid())
  channel        CommunicationChannel
  status         ConversationStatus  @default(OPEN)
  externalId     String?
  contactId      String?
  organizationId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  contact      Contact?     @relation(fields: [contactId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId, channel])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id             String          @id @default(cuid())
  conversationId String
  content        String
  type           MessageType     @default(TEXT)
  direction      MessageDirection
  read           Boolean         @default(false)
  externalId     String?
  metadata       Json?
  sentById       String?
  createdAt      DateTime        @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation(fields: [sentById], references: [id])

  @@index([conversationId])
  @@map("messages")
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
  VOIP
  SMS
}

enum ConversationStatus {
  OPEN
  CLOSED
  PENDING
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEMPLATE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// ─── Activities ───────────────────────────────────────────────────────────────

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType
  description    String
  metadata       Json?
  contactId      String?
  dealId         String?
  userId         String?
  organizationId String
  createdAt      DateTime     @default(now())

  contact Contact? @relation(fields: [contactId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([contactId])
  @@index([dealId])
  @@map("activities")
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  STAGE_CHANGE
  DEAL_CREATED
  CONTACT_CREATED
  MESSAGE_SENT
  MESSAGE_RECEIVED
}

