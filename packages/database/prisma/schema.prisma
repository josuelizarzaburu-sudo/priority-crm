enum WaMsgDirection {
  INBOUND
  OUTBOUND
}

enum WaMsgType {
  TEXT
  DOCUMENT
  IMAGE
}

enum WaMsgStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ═══════════════════════════════════════════════════════════════════════
//  MÓDULO DE OPERACIONES — Base de clientes
//  Un Cliente es una persona (única por identificación). Tiene N pólizas y
//  N dependientes. Cada póliza registra a cuáles dependientes cubre.
// ═══════════════════════════════════════════════════════════════════════

enum Genero {
  MASCULINO
  FEMENINO
  OTRO
}

enum EstadoPoliza {
  NUEVO
  RENOVADO
  CARTA_DE_NOMBRAMIENTO
  CANCELADA
}

enum FormaPago {
  CONTADO
  MENSUAL
  DIFERIDO
  DIFERIDO_ESPECIAL
}

enum Parentesco {
  CONYUGE
  HIJO
  HIJA
  PADRE
  MADRE
  HERMANO
  HERMANA
  CUNADO
  OTRO
}

// Los 4 ramos que maneja Priority. Cada uno muestra campos distintos en la
// ficha: un auto necesita placa y marca, un seguro de vida necesita el tiempo
// de cobertura, etc.
enum TipoPoliza {
  SALUD
  AUTO
  VIDA
  HOGAR
}

model Cliente {
  id              String    @id @default(cuid())
  nombres         String
  apellidos       String
  identificacion  String
  genero          Genero?
  fechaNacimiento DateTime?

  // Como prefiere que le llamen. Se resalta en dorado dentro del nombre completo.
  nombrePreferido String?
  // Quien lo refirio. "NO APLICA" cuando no viene de una referencia.
  referidoDe      String?
  // A quien se contacta: "ASEGURADO", "NINGUNO" o el nombre de otra persona
  // (esposa, hijo, asistente...). Texto libre a proposito: no siempre es
  // alguien que exista en el sistema.
  contactoSugerido String?

  email           String?
  telefono        String?
  celular         String?
  ciudad          String?
  direccion       String?

  /// De donde vino el cliente: PRIORITY_HEALTH (web y campañas), PRIORITY
  /// (carga por Excel del jefe de equipo) o PROPIO (lo consiguio el asesor).
  /// Se copia del deal al ganarlo; antes ese dato se perdia al crear la ficha.
  origenLead      String?
  /// Si traia un seguro anterior, y de que aseguradora. Texto y no booleano para
  /// poder guardar el nombre de la aseguradora previa.
  vieneDeOtroSeguro String?
  notas           String?

  // La cedula se puede corregir UNA sola vez por la ejecutiva (para arreglar
  // un error de digitacion). Despues queda congelada para ella; el jefe de
  // operaciones y el SUPER_ADMIN siguen pudiendo editarla siempre.
  cedulaEditada   Boolean   @default(false)

  // Semáforo de calidad de datos: el registro entra igual, pero marcado.
  revisar         Boolean   @default(false)
  revisarMotivo   String?

  organizationId  String
  // Manda en los permisos: un usuario OPERACIONES solo lee clientes donde
  // ejecutivoId == su id. El filtro va en el servidor, nunca solo en la UI.
  ejecutivoId     String?
  ejecutivoNombre String?

  /// Empresa a la que pertenece, en clientes corporativos. Va aqui y no en la
  /// poliza porque se busca por cliente: "que clientes tengo de tal empresa".
  empresa         String?
  /// INDIVIDUAL o CORPORATIVO.
  tipoCliente     String?

  /// Quien vendio la poliza.
  ///
  /// Se guarda el NOMBRE ademas del id porque parte de las ventas historicas
  /// las hicieron vendedores que ya no estan y que nunca tuvieron usuario en el
  /// CRM. Si solo hubiera relacion, esas ventas quedarian sin agente.
  agenteNombre    String?
  agenteId        String?
  // Enganche con el área comercial: de qué contacto/lead salió este cliente.
  contactId       String?   @unique
  createdById     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ejecutivo       User?         @relation("ClienteEjecutivo", fields: [ejecutivoId], references: [id])
  agente          User?         @relation("ClienteAgente", fields: [agenteId], references: [id], onDelete: SetNull)
  createdBy       User?         @relation("ClienteCreatedBy", fields: [createdById], references: [id])
  contact         Contact?      @relation(fields: [contactId], references: [id])
  polizas         Poliza[]
  dependientes    Dependiente[]
  notas_          NotaCliente[]
  reclamos        Reclamo[]
  requerimientos  Requerimiento[]
  correosAutomaticos CorreoAutomatico[]
  tareas          Tarea[]

  @@unique([organizationId, identificacion])
  @@index([organizationId, ejecutivoId])
  @@index([organizationId, empresa])
  @@index([agenteId])
  @@index([organizationId, apellidos])
  @@index([identificacion])
  @@map("clientes")
}

model Poliza {
  id              String        @id @default(cuid())
  // Define que campos se muestran/piden en la ficha.
  tipo            TipoPoliza    @default(SALUD)
  /// Numero de contrato de la aseguradora: la llave con la que operaciones
  /// identifica la poliza al hablar con la compania.
  numeroContrato  String?
  /// Mensual, Anual, Semestral... tal como lo maneja la aseguradora.
  frecuenciaPago  String?
  estado          EstadoPoliza?
  aseguradora     String?
  plan            String?
  deducible       String?
  formaPago       FormaPago?
  fechaEmision    DateTime?
  fechaRenovacion DateTime?
  primaNeta       Decimal?      @db.Decimal(12, 2)
  // Aplica a AUTO, VIDA y HOGAR.
  sumaAsegurada   Decimal?      @db.Decimal(14, 2)

  // ── Solo AUTO ──
  marca           String?
  modelo          String?
  anio            Int?
  placa           String?

  // ── Solo VIDA ── periodo de cobertura, ej "30 AÑOS"
  tiempoCobertura String?

  observacion     String?

  revisar         Boolean       @default(false)
  revisarMotivo   String?

  clienteId       String
  organizationId  String

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  cliente         Cliente             @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dependientes    PolizaDependiente[]

  renovaciones    Renovacion[]

  @@index([clienteId])
  @@index([organizationId, aseguradora])
  @@index([organizationId, fechaRenovacion])
  requerimientos  Requerimiento[]

  @@index([organizationId, tipo])
  @@map("polizas")
}

model Dependiente {
  id              String     @id @default(cuid())
  nombres         String
  apellidos       String?
  identificacion  String?
  fechaNacimiento DateTime?
  parentesco      Parentesco @default(OTRO)

  clienteId       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  cliente         Cliente             @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  polizas         PolizaDependiente[]

  @@index([clienteId])
  @@map("dependientes")
}

model PolizaDependiente {
  polizaId      String
  dependienteId String

  poliza        Poliza      @relation(fields: [polizaId], references: [id], onDelete: Cascade)
  dependiente   Dependiente @relation(fields: [dependienteId], references: [id], onDelete: Cascade)

  @@id([polizaId, dependienteId])
  @@index([dependienteId])
  @@map("poliza_dependientes")
}

// ─── Bitácora del cliente ────────────────────────────────────────────────
// Notas que las ejecutivas van dejando: qué pidió el cliente, qué se acordó,
// qué gestión quedó pendiente. A propósito NO se pueden editar ni borrar: es
// un historial, no un campo de texto. Por eso tampoco tiene updatedAt.
model NotaCliente {
  id        String   @id @default(cuid())
  contenido String

  clienteId String
  autorId   String?
  // Nombre del autor guardado tal cual al momento de escribir, para que la
  // nota siga siendo legible aunque esa persona ya no trabaje en Priority.
  autorNombre String?

  createdAt DateTime @default(now())

  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  autor     User?    @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([clienteId, createdAt])
  @@map("notas_cliente")
}

// ─── Reclamos / reembolsos ───────────────────────────────────────────────
enum EstadoReclamo {
  EN_TRAMITE // enviado a la aseguradora, sin respuesta todavía
  LIQUIDADO  // la aseguradora ya liquidó
  NEGADO     // la aseguradora lo negó
  DEVUELTO   // devuelto para completar documentación
}

model Reclamo {
  id             String        @id @default(cuid())
  organizationId String

  // El vínculo con el cliente es OPCIONAL a propósito: los reclamos históricos
  // vienen del Excel sin cédula, así que se cargan con el nombre en texto y se
  // enganchan después, cuando esté completa la base de clientes.
  clienteId      String?
  clienteNombre  String
  // Quién recibió la atención. Puede ser el titular o un dependiente.
  pacienteNombre String?

  aseguradora    String?
  /// Numero de contrato de la aseguradora: la llave con la que operaciones
  /// identifica la poliza al hablar con la compania.
  /// Mensual, Anual, Semestral... tal como lo maneja la aseguradora.
  // "INDIVIDUAL" o el nombre de la empresa en contratos corporativos (ej. FAES FARMA)
  contrato       String?
  diagnostico    String?

  /// Reembolso: el cliente ya pago y se le devuelve el dinero.
  /// Credito hospitalario: la aseguradora paga directo a la clinica.
  /// Son flujos y tiempos distintos, por eso se distinguen.
  tipoReclamo    TipoReclamo @default(REEMBOLSO)

  // Solo la hoja corporativa la usa; en las individuales no existe.
  fechaRecepcion       DateTime?
  fechaEnvioAseguradora DateTime?
  // Número de liquidación. Va como texto porque a veces trae letras.
  liquidacion          String?
  fechaLiquidacion     DateTime?
  fechaEnvioCliente    DateTime?

  // Lo que el cliente presentó a la aseguradora.
  valor          Decimal?      @db.Decimal(12, 2)
  // Lo que la aseguradora terminó liquidando. Suele ser menor que el presentado.
  valorLiquidado Decimal?      @db.Decimal(12, 2)
  estado         EstadoReclamo @default(EN_TRAMITE)

  medioComunicacion String?
  observaciones     String?
  // detalle: eliminado a pedido de Josue; la informacion va a la bitacora.
  notas             NotaReclamo[]

  // Igual que en clientes: id si la persona existe como usuario, y el nombre
  // siempre en texto (hay reclamos gestionados por gente que ya no trabaja aquí).
  ejecutivoId    String?
  ejecutivoNombre String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cliente        Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  ejecutivo      User?         @relation(fields: [ejecutivoId], references: [id], onDelete: SetNull)

  @@index([organizationId, ejecutivoId])
  @@index([organizationId, estado])
  @@index([clienteId])
  @@index([organizationId, fechaEnvioAseguradora])
  @@map("reclamos")
}

enum TipoRequerimiento {
  /// Se crea SOLO al asignarle ejecutiva a un cliente nuevo: verificar datos y
  /// mandarle el correo de bienvenida.
  BIENVENIDA
  DATOS_FACTURACION
  CAMBIO_FORMA_PAGO
  CAMBIO_DEDUCIBLE
  ACTUALIZACION_DATOS
  INCLUSION_DEPENDIENTES
  EXCLUSION_DEPENDIENTES
  CANCELACION
  COTIZACION
  PRE_NOTIFICACION
  OTROS
}

enum EstadoRequerimiento {
  EN_TRAMITE   // recibido, en gestión
  MAS_INFORMACION // se pidió información adicional al cliente
  SOLUCIONADO  // cerrado
}

enum TipoReclamo {
  REEMBOLSO             // el cliente pago y se le devuelve
  CREDITO_HOSPITALARIO  // la aseguradora paga directo a la clinica
}

enum EstadoRenovacion {
  POR_RENOVAR              // entra aquí por defecto
  ENVIAR
  ENVIADO
  EN_PROCESO
  RENOVADO_PAGO_PENDIENTE
  RENOVADO
}

enum EstadoEnvio {
  NO_ENVIADO
  PRIMER_ENVIO
  SEGUNDO_ENVIO
}


/// Historial de Priority Help.
///
/// Existe para saber QUE preguntan los asesores: donde falta material, que
/// dudas se repiten y en que casos el bot no supo responder. Sin esto, ir
/// llenando los huecos del conocimiento depende de que alguien avise.
///
/// Guarda la pregunta, la respuesta y los documentos que se usaron. Con
/// `sinRespuesta` se marcan los casos en que el bot admitio no tener el
/// dato: esa es la lista de trabajo para saber que documento subir.
model PriorityHelpConsulta {
  id        String   @id @default(cuid())
  userId    String
  pregunta  String
  respuesta String
  /// Archivos .md que se le pasaron al modelo en esa consulta.
  fuentes   String[]
  /// true si el bot dijo que no tenia el dato. Marca un hueco del material.
  sinRespuesta Boolean @default(false)
  /// true si se activo el filtro de precios sobre la salida del modelo.
  filtroPrecio Boolean @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([sinRespuesta])
  @@map("priority_help_consultas")
}
